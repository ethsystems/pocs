pragma solidity ^0.8.20;

import {Script, console} from "forge-std/src/Script.sol";
import {Config} from "forge-std/src/Config.sol";
import {HonkVerifier as DepositHonkVerifier} from "../src/verifiers/DepositVerifier.sol";
import {HonkVerifier as TransferHonkVerifier} from "../src/verifiers/TransferVerifier.sol";
import {HonkVerifier as WithdrawHonkVerifier} from "../src/verifiers/WithdrawVerifier.sol";
import {HonkVerifier as WithdrawUngatedHonkVerifier} from "../src/verifiers/WithdrawUngatedVerifier.sol";

/// @title DeployVerifiers
/// @notice Deploys the four verifiers generated by `scripts/generate-verifiers.sh`
///         and records their addresses. `Deploy.s.sol` reuses any address it finds
///         nonzero, so running this first keeps four roughly 24 KB CREATEs out of
///         the main deployment.
contract DeployVerifiers is Script, Config {
    function run() public {
        _loadConfig("./deployments.toml", true);

        vm.startBroadcast();

        address depositVerifier = address(new DepositHonkVerifier());
        address transferVerifier = address(new TransferHonkVerifier());
        address withdrawVerifier = address(new WithdrawHonkVerifier());
        address withdrawUngatedVerifier = address(new WithdrawUngatedHonkVerifier());

        vm.stopBroadcast();

        config.set("deposit_verifier_address", depositVerifier);
        config.set("transfer_verifier_address", transferVerifier);
        config.set("withdraw_verifier_address", withdrawVerifier);
        config.set("withdraw_ungated_verifier_address", withdrawUngatedVerifier);

        console.log("");
        console.log("=== Verifier Deployment Summary ===");
        console.log("DepositVerifier:", depositVerifier);
        console.log("TransferVerifier:", transferVerifier);
        console.log("WithdrawVerifier:", withdrawVerifier);
        console.log("WithdrawUngatedVerifier:", withdrawUngatedVerifier);
    }
}
