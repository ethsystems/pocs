PRIVATE_KEY=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# false deploys the four bb-generated HonkVerifiers; true deploys the mocks.
# The integration harness sets this from the same variable that picks its
# in-process prover, so the two can never disagree.
USE_MOCK_VERIFIER=true

GOVERNANCE=0x0000000000000000000000000000000000000000
TIMELOCK_CONTROLLER=0x0000000000000000000000000000000000000000
GUARDIAN=0x0000000000000000000000000000000000000000
CURATOR=0x0000000000000000000000000000000000000000
COMMITTEE=0x0000000000000000000000000000000000000000
BLOCKED_FUNDS_ACCOUNT=0x0000000000000000000000000000000000000000

# Set from a prior DeployVerifiers run when verifiers deploy out of band.
DEPOSIT_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
TRANSFER_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
WITHDRAW_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
WITHDRAW_UNGATED_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
