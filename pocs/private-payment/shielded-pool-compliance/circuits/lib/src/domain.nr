pub global CN_TAG: Field = 1461501637330902918203684832716283019655932542977;
pub global VN_TAG: Field = 1461501637330902918203684832716283019655932542978;
pub global STATE_DOMAIN: Field = 1461501637330902918203684832716283019655932542979;
pub global NO_COUNTERPARTY: Field = 1461501637330902918203684832716283019655932542980;
pub global NO_EXIT: Field = 1461501637330902918203684832716283019655932542981;

pub global MAX_COMMITMENT_TREE_DEPTH: u32 = 32;
pub global MAX_ATTESTATION_TREE_DEPTH: u32 = 20;
pub global ATTESTER_TREE_DEPTH: u32 = 5;
pub global EPOCH_SECONDS: u64 = 86400;

#[test]
fn test_tags_sit_above_2_pow_160() {
    let two_pow_160: Field = 1461501637330902918203684832716283019655932542976;
    assert(CN_TAG == two_pow_160 + 1);
    assert(VN_TAG == two_pow_160 + 2);
    assert(STATE_DOMAIN == two_pow_160 + 3);
    assert(NO_COUNTERPARTY == two_pow_160 + 4);
    assert(NO_EXIT == two_pow_160 + 5);
}
